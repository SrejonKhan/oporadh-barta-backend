// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                     Int                     @id @default(autoincrement())
  createdAt              DateTime                @default(now())
  email                  String                  @unique
  username               String                  @unique
  phoneNumber            String                  @unique
  displayName            String?
  passwordHash           String
  isVerified             Boolean                 @default(false)
  role                   Role                    @default(USER)
  authType               AuthType                @default(EMAILPASS)
  otpSecret              OtpSecret[]          
  userProfile            UserProfile?
  changePasswordRequests ChangePasswordRequest[]
  crimeReports           CrimeReport[]
}

model OtpSecret {
  id        Int      @id @default(autoincrement())
  secret    String   @unique
  user      User     @relation(fields: [userId], references: [id])
  userId    Int      @unique
  createdAt DateTime @default(now())
}

enum Role {
  USER
  ADMIN
}

enum AuthType {
  EMAILPASS
  OAUTH
}

model UserProfile {
  profileIntro String?
  designation  String?
  avatarUrl    String?
  socialLinks  SocialLink[]
  user         User         @relation(fields: [userId], references: [id])
  userId       Int          @unique
}

model SocialLink {
  url         String
  host        SocialLinkHost @default(UNKNOWN)
  userProfile UserProfile    @relation(fields: [userId], references: [userId])
  userId      Int            @unique
}

enum SocialLinkHost {
  LINKEDIN
  GITHUB
  FACEBOOK
  INSTAGRAM
  MAIL
  TWITTER
  UNKNOWN
}

model ChangePasswordRequest {
  token        String   @unique
  reqIpAddress String
  requestedAt  DateTime @default(now())
  user         User     @relation(fields: [userId], references: [id])
  userId       Int      @unique
}

model CrimeReport {
  id          Int        @id @default(autoincrement())
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  title       String
  description String
  location    Location   @relation(fields: [locationId], references: [id], name: "LocationReports")
  locationId  Int
  media       Media[]
  status      ReportStatus @default(PENDING)
  reporter    User     @relation(fields: [reporterId], references: [id])
  reporterId  Int
}


model Location {
  id         Int           @id @default(autoincrement())
  division   String
  district   String
  fullAddress String?
  latitude   Float?
  longitude  Float?
  reports    CrimeReport[] @relation("LocationReports") // Explicit relation name
}


model Media {
  id           Int        @id @default(autoincrement())
  url          String
  type         MediaType
  crimeReport  CrimeReport @relation(fields: [reportId], references: [id])
  reportId     Int
}

enum MediaType {
  IMAGE
  VIDEO
}

enum ReportStatus {
  PENDING
  INVESTIGATING
  RESOLVED
  REJECTED
  VERIFIED
}
